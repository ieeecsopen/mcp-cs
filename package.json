{
  "name": "mcp-cs",
  "version": "2.2.0",
  "description": "MCS (mcp-cs) — IEEE Computer Society Universal Campus Developer, Diagnostics & AlgoJudge Competitive Execution MCP Server",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcs": "./dist/index.js",
    "mcp-cs": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "Formula",
    "skills"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/ui && cp src/ui/*.html dist/ui/ && cp -r skills dist/ && chmod +x dist/index.js",
    "prepublishOnly": "npm run test && npm run build",
    "test": "vitest run",
    "start": "node dist/index.js",
    "start:relay": "node dist/index.js --relay",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcs",
    "mcp-cs",
    "mcp",
    "model-context-protocol",
    "ieee-cs",
    "algojudge",
    "campus-developer",
    "database-erd",
    "performance-audit",
    "codeforces",
    "competitive-programming",
    "stress-testing",
    "code-execution",
    "developer-tools",
    "claude",
    "cursor",
    "antigravity"
  ],
  "author": "IEEE Computer Society of SLIIT",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}